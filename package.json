{
  "name": "pi-orchard",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./packages/pi-automode/src/index.ts",
      "./packages/pi-subagent/src/index.ts"
    ]
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"packages/*/test/**/*.test.ts\""
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@earendil-works/pi-tui": "1.2.0",
    "@types/node": "24.19.2",
    "typebox": "1.3.27",
    "typescript": "7.0.2"
  }
}
